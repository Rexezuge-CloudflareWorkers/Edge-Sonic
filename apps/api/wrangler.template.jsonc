{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-sonic",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "routes": [],
  "placement": {
    "mode": "off",
  },
  "assets": {
    "directory": "./apps/web/dist/",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCAN",
        "class_name": "ScanWorker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1000000000",
      "new_sqlite_classes": ["ScanWorker"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "edge-sonic-db",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],

  // One secret per feature, and never merged.
  //
  // The three fields are the whole schema (`additionalProperties: false`, and `wrangler
  // typegen` rejects anything else):
  //
  // - `binding`  - the name the Worker reads it as, `env.SUBSONIC_USER_ENCRYPTION_KEY_SECRET`.
  //                It is an object with a `.get()` method, not a string; typing it as a
  //                string would compile and then resolve to undefined, turning every
  //                credential read into a silent failure.
  // - `store_id` - the Secrets Store that holds it. 32 zeros below is a PLACEHOLDER, and
  //                it must stay that exact string: `scripts/prepare-wrangler-config.ts`
  //                patches only a `store_id` equal to `DEFAULT_HEX_ID` (the same sentinel
  //                the D1 `database_id` and the KV `id` above use). A friendlier
  //                placeholder - `REPLACE_WITH_YOUR_SECRETS_STORE_ID` - is skipped without
  //                a word, reaches `wrangler deploy` unpatched, and fails there with
  //                Cloudflare error 10182 rather than here.
  // - `secret_name` - the key's name *inside* the store. The two are deliberately
  //                different strings (`edge-sonic-subsonic-user-encryption-key` and
  //                `edge-sonic-webdav-encryption-key`), so a binding and a stored value
  //                cannot be confused for each other in a log or a support ticket.
  //
  // One store, two secrets: `ensureSecretStore()` resolves a single id and writes it to
  // every entry, so rotating one key never has to move the other.
  //
  // `scripts/init-secrets.ts` reads this array, creates anything missing, and writes a
  // fresh 32-byte AES-256 key for each.
  //
  // Two keys, not one, because they guard different things. Rotating the WebDAV credential
  // must not require re-entering every user's password, and a compromise of one store must
  // not yield both. `users.key_version` and `users.token_epoch` exist for the same reason.
  //
  // NOTE: this field is NOT inherited by a named `env.*` block, so a multi-environment
  // deployment has to repeat it in each one.
  "secrets_store_secrets": [
    {
      "binding": "SUBSONIC_USER_ENCRYPTION_KEY_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "edge-sonic-subsonic-user-encryption-key",
    },
    {
      "binding": "WEBDAV_ENCRYPTION_KEY_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "edge-sonic-webdav-encryption-key",
    },
  ],

  // No DEV_AUTH_EMAIL / DEMO_MODE here on purpose, and no raw
  // SUBSONIC_USER_ENCRYPTION_KEY / WEBDAV_ENCRYPTION_KEY.
  //
  // The first two are authentication bypasses: with either set, every unauthenticated
  // request authenticates as that identity. `isBypassAllowed()` only honors them for
  // ENVIRONMENT in {development, dev, local, test}, but shipping a ready-made bypass
  // identity inside the production template makes a one-word edit - `ENVIRONMENT:
  // "staging"`, or an `env.staging` block that inherits `vars` - a full account takeover
  // with no attacker effort. `validate()` warns when one is present but inert, which is
  // exactly the case worth warning about.
  //
  // The raw keys are a TEST-ONLY escape hatch so `wrangler dev` works without a Secrets
  // Store. They are absent here on purpose, and `resolveKey` is written so a broken
  // binding can never be masked by one.
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG_MODE": "false",
    "SITE_URL": "",

    // Cloudflare Access, required for /user and nothing else. /rest authenticates
    // against the users table, so these have no defaults on purpose: a typo here
    // presents as an Access outage rather than as a failed startup.
    "TEAM_DOMAIN": "",
    "POLICY_AUD": "",

    // Library and scan limits.
    "MAX_LIBRARIES": "10",
    "WEBDAV_TIMEOUT_MS": "10000",

    // SCAN_CHUNK_FOLDERS bounds D1 work (frontier rows read, rows written) against the
    // 5,000-rows/day allowance. It is NOT the subrequest bound — that is the next one.
    "SCAN_CHUNK_FOLDERS": "40",

    // Subrequests one scan chunk may issue. Exceeding the platform's ceiling does not
    // slow a chunk down, it FAILS it, so this is a hard limit.
    //
    // Workers allow 50 external subrequests per invocation on the Free plan and 10,000
    // on Paid (the 1,000 figure older versions of this file assumed was retired on
    // 2026-02-11). 40 leaves ten for redirect chains, which are counted too.
    //
    // On Workers Paid, raise this — or set `limits.subrequests` in your own config —
    // and scans finish in proportionally fewer polls. The default is the one that
    // cannot fail on an account that never raised it.
    "SCAN_CHUNK_MAX_REQUESTS": "40",

    // Milliseconds one scan chunk may take. A chunk is `folders x per-request latency`
    // with nothing else stopping it, and polling `getScanStatus` IS the scan: a client
    // that times out and backs off has stopped advancing it. Checked between units of
    // work, so a chunk overruns by at most one in-flight request.
    "SCAN_CHUNK_DEADLINE_MS": "20000",

    "MAX_PAGE_SIZE": "500",
    "DEFAULT_PAGE_SIZE": "20",

    // Tag enrichment reads at most this many bytes from the front of a file. A prefix
    // read, never a whole file: a 4 GiB track must not be pulled through the Worker to
    // learn its length.
    "TAG_READ_BYTES": "131072",

    // A container whose length is recorded at the *end* of the file needs a second read
    // from the other end: an Ogg granule position lives in its final page's header, so a
    // prefix read cannot see it. One whole Ogg page body is 255 x 255 bytes, plus a
    // 27-byte header, so 65536 guarantees the final page's header is inside the range.
    // Set to 0 to disable: an Ogg track then reports no duration rather than a wrong one.
    "TAG_READ_TAIL_BYTES": "65536",

    // Tracks the scan enriches per folder, per chunk. A bound on the SHAPE of one
    // folder, separate from the chunk's request ceiling above: without it, one album of
    // 500 changed tracks takes the whole budget and the folders behind it are never
    // walked. An Ogg track costs a prefix read and a tail read, and the scan admits one
    // on the cost of two. What does not fit is enriched on first play instead.
    "SCAN_ENRICH_MAX_PER_FOLDER": "20",

    // Streaming and the auth throttle.
    "STREAM_RATE_LIMIT": "600",
    "STREAM_TIMEOUT_MS": "30000",
    "AUTH_FAILURE_LIMIT": "10",
    "AUTH_FAILURE_WINDOW_SECONDS": "900",

    // Unset means "allowed outside production", so a co-located dev server works, and
    // "denied" in production. Set it only deliberately: the Worker fetches base_url with
    // the library's stored DAV password, so a private address here is a way to send that
    // credential somewhere the operator cannot see.
    "ALLOW_PRIVATE_WEBDAV_HOSTS": "",

    "LOG_LEVEL": "info",
  },
}
