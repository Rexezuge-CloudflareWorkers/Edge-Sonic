{
  "name": "@edge-sonic/backend-services",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./composition": "./src/composition/index.ts",
    "./composition/*": "./src/composition/*.ts",
    "./errors": "./src/errors/index.ts",
    "./errors/*": "./src/errors/*.ts",
    "./import": "./src/import/index.ts",
    "./import/*": "./src/import/*.ts",
    "./index": "./src/index/index.ts",
    "./index/*": "./src/index/*.ts",
    "./library": "./src/library/index.ts",
    "./library/*": "./src/library/*.ts",
    "./queue": "./src/queue/index.ts",
    "./queue/*": "./src/queue/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@edge-sonic/backend-data": "workspace:*",
    "@edge-sonic/backend-errors": "workspace:*",
    "@edge-sonic/backend-runtime": "workspace:*",
    "@edge-sonic/media-tags": "workspace:*",
    "@edge-sonic/shared": "workspace:*",
    "@edge-sonic/subsonic": "workspace:*",
    "@edge-sonic/webdav": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "6.0.3"
  }
}
